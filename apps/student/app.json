{
  "expo": {
    "name": "Kormic",
    "slug": "kormic-student",
    "version": "0.1.1",
    "orientation": "portrait",
    "scheme": "kormicstudent",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kormic.student",
      "associatedDomains": [
        "applinks:app.kormic.ai"
      ]
    },
    "android": {
      "package": "com.kormic.student",
      "versionCode": 2,
      "googleServicesFile": "./firebase/google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.kormic.ai",
              "path": "/claim"
            },
            {
              "scheme": "https",
              "host": "app.kormic.ai",
              "path": "/claim/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "icon": "./assets/kormic-logo.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Kormic to scan your face to secure your account.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a68e49e4-277c-4056-af1c-e741dad8edc4"
      }
    },
    "experiments": {
      "baseUrl": "/student"
    },
    "icon": "./assets/kormic-logo.png"
  }
}
